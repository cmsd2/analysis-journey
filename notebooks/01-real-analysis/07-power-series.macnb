.121085594806872,3.202999463991899,3.2893289320696053,3.3804409253488195,3.4767441824458207,3.5786953845349254,3.6868063965475426,3.8016528613783773,3.9238844512527162,4.054237160926123,4.193548132540371,4.342773640294795,4.503011046457532,4.675525785163285,4.861784760136573,5.063497989747742,5.282670944304375,5.521670862908615,5.783311506465041,6.070962438018155,6.388691222483823,6.741450197694179,7.135324115228223,7.577861609709604,8.078523050412628,8.649291215745514,9.305511410458722,10.067057072408824,10.959959958747646,12.018707121600237,13.289499639740509,14.834904607964146,16.740533118006013,19.124673819247967],\"type\":\"scatter\",\"mode\":\"lines\",\"line\":{\"color\":\"red\",\"width\":1},\"name\":\"P_60\"},{\"x\":[-1.0,-1.0],\"y\":[-2.0,5.0],\"type\":\"scatter\",\"mode\":\"markers\",\"marker\":{\"color\":\"purple\",\"size\":6},\"name\":\"x = -1 (boundary)\"}],\"layout\":{\"title\":{\"text\":\"Geometric series — converges on (-1, 1), diverges beyond\"},\"showlegend\":true,\"width\":700,\"height\":450,\"plot_bgcolor\":\"white\",\"paper_bgcolor\":\"white\",\"xaxis\":{\"title\":{\"text\":\"x\"},\"showgrid\":true,\"gridcolor\":\"#ddd\",\"linecolor\":\"#ddd\",\"linewidth\":1,\"zerolinecolor\":\"black\",\"zerolinewidth\":1},\"yaxis\":{\"title\":{\"text\":\"partial sum\"},\"showgrid\":true,\"range\":[-2.0,12.0],\"gridcolor\":\"#ddd\",\"linecolor\":\"#ddd\",\"linewidth\":1,\"zerolinecolor\":\"black\",\"zerolinewidth\":1}}}"
