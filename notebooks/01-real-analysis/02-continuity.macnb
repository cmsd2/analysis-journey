,-1.3896075399577812,-1.4073622514075088,-1.4407206212366672,-1.588749183408941,-1.7881415316513627,-1.7624245195724741,-1.7507889051364465,-1.6789754589258876,-1.6420678086653182,-1.6919157549603443,-1.6113014654154398,-1.6306419521748612,-1.694790038004038,-1.8394858802140928,-1.9999960747432235],\"type\":\"scatter\",\"mode\":\"lines\",\"line\":{\"color\":\"purple\",\"width\":1},\"name\":\"W(x) (truncated)\"}],\"layout\":{\"title\":{\"text\":\"Weierstrass function — continuous everywhere, differentiable nowhere\"},\"showlegend\":true,\"width\":700,\"height\":450,\"plot_bgcolor\":\"white\",\"paper_bgcolor\":\"white\",\"xaxis\":{\"title\":{\"text\":\"x\"},\"showgrid\":true,\"gridcolor\":\"#ddd\",\"linecolor\":\"#ddd\",\"linewidth\":1,\"zerolinecolor\":\"black\",\"zerolinewidth\":1},\"yaxis\":{\"title\":{\"text\":\"W(x)\"},\"showgrid\":true,\"gridcolor\":\"#ddd\",\"linecolor\":\"#ddd\",\"linewidth\":1,\"zerolinecolor\":\"black\",\"zerolinewidth\":1}}}"
