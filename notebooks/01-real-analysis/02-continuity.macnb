44992,-0.9381666365421035,-0.9399302128979575,-0.9416655599820777,-0.9433727927262597,-0.9450520263029444,-0.9467033761142492,-0.9483269577811404,-0.9499228871327631,-0.9514912801959159,-0.9530322531846764,-0.9545459224901667,-0.956032404670471,-0.95749181644069,-0.9589242746631385],\"type\":\"scatter\",\"mode\":\"lines\",\"line\":{\"color\":\"purple\",\"width\":1},\"name\":\"sin(1/x)\"}],\"layout\":{\"title\":{\"text\":\"Essential discontinuity — oscillates infinitely often\"},\"showlegend\":true,\"width\":700,\"height\":450,\"plot_bgcolor\":\"white\",\"paper_bgcolor\":\"white\",\"xaxis\":{\"title\":{\"text\":\"x\"},\"showgrid\":true,\"gridcolor\":\"#ddd\",\"linecolor\":\"#ddd\",\"linewidth\":1,\"zerolinecolor\":\"black\",\"zerolinewidth\":1},\"yaxis\":{\"title\":{\"text\":\"sin(1/x)\"},\"showgrid\":true,\"gridcolor\":\"#ddd\",\"linecolor\":\"#ddd\",\"linewidth\":1,\"zerolinecolor\":\"black\",\"zerolinewidth\":1}}}"
            ]
          },
          "metadata": {},
