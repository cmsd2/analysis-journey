2798,0.1312663759599778,0.21892708509023392,0.36417906385030924,0.6042426622759612,1.0],\"type\":\"scatter\",\"mode\":\"lines\",\"line\":{\"color\":\"purple\",\"width\":2},\"name\":\"n=100\"}],\"layout\":{\"title\":{\"text\":\"x^n on [0,1] — pointwise limit is discontinuous\"},\"showlegend\":true,\"width\":700,\"height\":450,\"plot_bgcolor\":\"white\",\"paper_bgcolor\":\"white\",\"xaxis\":{\"title\":{\"text\":\"x\"},\"showgrid\":true,\"gridcolor\":\"#ddd\",\"linecolor\":\"#ddd\",\"linewidth\":1,\"zerolinecolor\":\"black\",\"zerolinewidth\":1},\"yaxis\":{\"title\":{\"text\":\"x^n\"},\"showgrid\":true,\"gridcolor\":\"#ddd\",\"linecolor\":\"#ddd\",\"linewidth\":1,\"zerolinecolor\":\"black\",\"zerolinewidth\":1}}}"
            ]
