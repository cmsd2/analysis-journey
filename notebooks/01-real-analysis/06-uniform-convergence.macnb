58550873117,0.8755141434650919,0.9169353351681566,0.9585886572927245,1.0009978601608807,1.0436480042067815,1.0870428954057378,1.1306929436795234,1.1750693325145707,1.2197251453634121,1.2650745599184157,1.3107488842608366,1.3570511748582645,1.403777929282055,1.45097103245123,1.4988778981193542,1.5466473859860863,1.59680608213355,1.6349839001848923],\"type\":\"scatter\",\"mode\":\"lines\",\"line\":{\"color\":\"blue\",\"width\":2},\"name\":\"N=100 partial (≈ uniform limit)\"}],\"layout\":{\"title\":{\"text\":\"Σ cos(nx)/n² — uniform convergence by Weierstrass M-test\"},\"showlegend\":true,\"width\":700,\"height\":450,\"plot_bgcolor\":\"white\",\"paper_bgcolor\":\"white\",\"xaxis\":{\"title\":{\"text\":\"x\"},\"showgrid\":true,\"gridcolor\":\"#ddd\",\"linecolor\":\"#ddd\",\"linewidth\":1,\"zerolinecolor\":\"black\",\"zerolinewidth\":1},\"yaxis\":{\"title\":{\"text\":\"partial sum\"},\"showgrid\":true,\"gridcolor\":\"#ddd\",\"linecolor\":\"#ddd\",\"linewidth\":1,\"zerolinecolor\":\"black\",\"zerolinewidth\":1}}}"
            ]
