63,1.9234951774418223,1.92682545738091,1.9313610864645137,1.9373171015175163,1.944920208085947,1.9544068167766797,1.966020727024888,1.9800104762815942,1.9966263965419262,2.016117445589748,2.0387279049032387,2.0646940569705587,2.0942409688463335,2.1275795136021407],[2.236067977499789,2.201467989523946,2.1705578018942355,2.1431396433835723,2.119003289928,2.097928638527084,2.0796884855682682,2.064051405589167,2.050784629222579,2.039656828770301,2.0304407348314264,2.0229155256235405,2.0168689500177917,2.0120991640519397,2.0084162774078815,2.0056436201571723,2.0036187505813277,2.002194232050513,2.001238211067449,2.000634830097858,2.0002845082323115,2.000104120571692,2.000027103960962,2.0000035126940574,2.0000000433666303,2.0000000433666303,2.0000035126940574,2.000027103960962,2.000104120571692,2.0002845082323115,2.000634830097858,2.001238211067449,2.002194232050513,2.0036187505813277,2.0056436201571723,2.0084162774078815,2.0120991640519397,2.0168689500177917,2.0229155256235405,2.030440734831426,2.039656828770301,2.050784629222579,2.064051405589167,2.0796884855682682,2.097928638527084,2.119003289928,2.1431396433835723,2.1705578018942355,2.201467989523946,2.236067977499789]],\"type\":\"surface\",\"name\":\"sqrt((-y^2+x^2+1)^2+4*x^2*y^2)\"}],\"layout\":{\"title\":{\"text\":\"|z² + 1| on the unit disc — maxes on the boundary\"},\"width\":700,\"height\":450,\"paper_bgcolor\":\"white\",\"scene\":{\"xaxis\":{\"title\":{\"text\":\"Re z\"},\"gridcolor\":\"#ddd\",\"linecolor\":\"#ddd\",\"linewidth\":1,\"zerolinecolor\":\"black\",\"zerolinewidth\":1},\"yaxis\":{\"title\":{\"text\":\"Im z\"},\"gridcolor\":\"#ddd\",\"linecolor\":\"#ddd\",\"linewidth\":1,\"zerolinecolor\":\"black\",\"zerolinewidth\":1},\"zaxis\":{\"title\":{\"text\":\"|f(z)|\"},\"gridcolor\":\"#ddd\",\"linecolor\":\"#ddd\",\"linewidth\":1,\"zerolinecolor\":\"black\",\"zerolinewidth\":1}}}}"
