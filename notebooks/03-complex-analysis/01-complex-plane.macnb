03381365403064,-0.35809848042919035,-0.3462317272752489,-0.33474277030349087,-0.3236333779871225,-0.3129026597478128,-0.30254748765846057,-0.292562874532201,-0.2829423098719257,-0.27367805591083505,-0.2647614064610098,-0.256182911561275,-0.24793257102752378,-0.24000000000000005],\"type\":\"scatter\",\"mode\":\"lines\",\"line\":{\"color\":\"red\",\"width\":1.5},\"name\":\"image under 1/z\"}],\"layout\":{\"title\":{\"text\":\"Möbius z → 1/z: horizontal lines map to circles\"},\"showlegend\":true,\"width\":700,\"height\":700,\"plot_bgcolor\":\"white\",\"paper_bgcolor\":\"white\",\"xaxis\":{\"title\":{\"text\":\"Re\"},\"showgrid\":true,\"gridcolor\":\"#ddd\",\"linecolor\":\"#ddd\",\"linewidth\":1,\"zerolinecolor\":\"black\",\"zerolinewidth\":1},\"yaxis\":{\"title\":{\"text\":\"Im\"},\"showgrid\":true,\"scaleanchor\":\"x\",\"scaleratio\":1,\"gridcolor\":\"#ddd\",\"linecolor\":\"#ddd\",\"linewidth\":1,\"zerolinecolor\":\"black\",\"zerolinewidth\":1}}}"
