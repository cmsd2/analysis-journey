73,1.4829975951246253,1.5892681321527495,1.7057956259000282,1.8319837290657481,1.965795847056057,2.1029461884413845,2.2360679774997902,2.354354778987094,2.4445060351935246,2.4936467495768384,2.4936467495768384,2.444506035193524,2.354354778987094,2.2360679774997902,2.1029461884413845,1.965795847056057,1.8319837290657481,1.7057956259000278,1.5892681321527493,1.4829975951246253,1.3867504905630728,1.2998673672393632,1.2215084223296078,1.150792911137501,1.0868726645779394,1.028966806066246,0.9763746171404236,0.9284766908852594,0.8847302435397277,0.8446618840169169,0.8078596332287763,0.7739651186519814,0.7426663815906102,0.7136914665004124,0.6868028197434453]],\"type\":\"surface\",\"name\":\"min(5,1/sqrt(y^2+(1-x)^2))\"}],\"layout\":{\"title\":{\"text\":\"|1/(1-z)| — finite inside |z|<1, blows up at the boundary\"},\"width\":700,\"height\":450,\"paper_bgcolor\":\"white\",\"scene\":{\"xaxis\":{\"title\":{\"text\":\"Re z\"},\"gridcolor\":\"#ddd\",\"linecolor\":\"#ddd\",\"linewidth\":1,\"zerolinecolor\":\"black\",\"zerolinewidth\":1},\"yaxis\":{\"title\":{\"text\":\"Im z\"},\"gridcolor\":\"#ddd\",\"linecolor\":\"#ddd\",\"linewidth\":1,\"zerolinecolor\":\"black\",\"zerolinewidth\":1},\"zaxis\":{\"title\":{\"text\":\"|f|\"},\"gridcolor\":\"#ddd\",\"linecolor\":\"#ddd\",\"linewidth\":1,\"zerolinecolor\":\"black\",\"zerolinewidth\":1}}}}"
            ]
