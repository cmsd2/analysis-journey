893941585948,0.05369956997609933,0.051337951385015845,0.048969792824919804,0.046601350048342295,0.04423938718739266,0.04189113242373257,0.0395642279083217,0.03726667438951744,0.0350067710727147,0.03279305129369045,0.03063421464044832,0.028539056203970042,0.02651639367630352,0.024574993044365546,0.02272349364930961,0.020970333394030014,0.01932367488514529,0.01779133329055104,0.01638070667939038,0.015098709588189861,0.013951710525199425,0.012945474085005055,0.012085108297702046,0.011375017781865181,0.01081886320886816,0.010419527518492705,0.010179089253018192,0.010098803299939004],\"type\":\"scatter\",\"mode\":\"lines\",\"line\":{\"color\":\"blue\",\"width\":1},\"name\":\"N = 10 partial sum\"}],\"layout\":{\"title\":{\"text\":\"L² Fourier convergence of triangle wave\"},\"showlegend\":true,\"width\":700,\"height\":450,\"plot_bgcolor\":\"white\",\"paper_bgcolor\":\"white\",\"xaxis\":{\"title\":{\"text\":\"x\"},\"showgrid\":true,\"gridcolor\":\"#ddd\",\"linecolor\":\"#ddd\",\"linewidth\":1,\"zerolinecolor\":\"black\",\"zerolinewidth\":1},\"yaxis\":{\"title\":{\"text\":\"value\"},\"showgrid\":true,\"gridcolor\":\"#ddd\",\"linecolor\":\"#ddd\",\"linewidth\":1,\"zerolinecolor\":\"black\",\"zerolinewidth\":1}}}"
