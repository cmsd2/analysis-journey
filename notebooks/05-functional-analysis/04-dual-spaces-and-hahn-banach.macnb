4274882405566,-1.2246467991473532e-16],\"type\":\"scatter\",\"mode\":\"lines\",\"line\":{\"color\":\"blue\",\"width\":2},\"name\":\"convex set A (disc)\"},{\"x\":[1.5,2.0,2.5,3.0,1.5,2.0,2.5,3.0],\"y\":[0.0,0.5,0.0,-0.5,-0.5,0.5,-0.3,0.3],\"type\":\"scatter\",\"mode\":\"markers\",\"marker\":{\"color\":\"red\",\"size\":4},\"name\":\"convex set B (right of x=1)\"},{\"x\":[0.5,0.5],\"y\":[-1.5,1.5],\"type\":\"scatter\",\"mode\":\"lines\",\"line\":{\"color\":\"green\",\"width\":2,\"dash\":\"dash\"},\"name\":\"separating hyperplane\"}],\"layout\":{\"title\":{\"text\":\"Hahn-Banach separation: a line splits two disjoint convex sets\"},\"showlegend\":true,\"width\":700,\"height\":700,\"plot_bgcolor\":\"white\",\"paper_bgcolor\":\"white\",\"xaxis\":{\"title\":{\"text\":\"x\"},\"showgrid\":true,\"gridcolor\":\"#ddd\",\"linecolor\":\"#ddd\",\"linewidth\":1,\"zerolinecolor\":\"black\",\"zerolinewidth\":1},\"yaxis\":{\"title\":{\"text\":\"y\"},\"showgrid\":true,\"scaleanchor\":\"x\",\"scaleratio\":1,\"gridcolor\":\"#ddd\",\"linecolor\":\"#ddd\",\"linewidth\":1,\"zerolinecolor\":\"black\",\"zerolinewidth\":1}}}"
