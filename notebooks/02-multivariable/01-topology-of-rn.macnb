04,-0.18561699687907493,-0.20683141474426917,-0.22783965855714797,-0.24862078684339958,-0.2691540845224075,-0.28941908355649376,-0.3093955833539055,-0.3290636709052019,-0.3484037406329779,-0.3673965139351278,-0.3860230584021751,-0.40426480668951215,-0.42210357502573,-0.43952158133860064,-0.45650146298063055,-0.4730262940365261,-0.48907960219531466,-0.5046453851703014,-0.519708126650498,-0.5342528117676177,-0.5482649420632232,-0.5617305499411046,-0.5746362125904837,-0.5869690653661639,-0.5987168146122881,-0.6098677499169216,-0.6204107557852462,-0.630335322719726,-0.6396315576962055,-0.6482901940254887,-0.6563026005905775,-0.6636607904503568,-0.6703574288011506,-0.6763858402882151,-0.6817400156598763,-0.6864146177576829,-0.6904049868366019,-0.6937071452099545,-0.6963178012144599,-0.6982343524914371,-0.6994548885808929,-0.6999781928259093,-0.6998037435854345,-0.6989317147542652,-0.6973629755897047,-0.6950990898450687,-0.6921423142109018,-0.688495596065459,-0.684162570536695,-0.6791475568786904,-0.6734555541661239,-0.6670922363110876,-0.6600639464072059,-0.6523776904067046,-0.6440411301367222,-0.6350625756618369,-0.625450977000412,-0.6152159152030222,-0.6043675928018566,-0.5929168236406093,-0.580875022095008,-0.5682541916947146,-0.555066913157945,-0.5413263318507376,-0.527046144683364,-0.5122405864569537,-0.49692441567393314,-0.48111289982642896,-0.4648218001773017,-0.4480673560489751,-0.4308662686357258,-0.41323568435557007,-0.3951931777583426,-0.37675673400700177,-0.35794473094962875,-0.33877592079998753,-0.3192694114449114,-0.2994446473971467,-0.27932139041263837,-0.25891969979158286,-0.2382599123828794,-0.21736262231191836,-0.19624866045191003,-0.17493907365921554,-0.153455103793384,-0.13181816654280293,-0.11004983007707574,-0.08817179354740223,-0.06620586545639115,-0.0441739419188716,-0.02209798483536779,-1.7145055188062944e-16],\"type\":\"scatter\",\"mode\":\"markers\",\"marker\":{\"color\":\"lightblue\",\"size\":4},\"name\":\"interior\"}],\"layout\":{\"title\":{\"text\":\"Open ball B_1(0) in ℝ² — disc, boundary excluded\"},\"showlegend\":true,\"width\":700,\"height\":700,\"plot_bgcolor\":\"white\",\"paper_bgcolor\":\"white\",\"xaxis\":{\"title\":{\"text\":\"x₁\"},\"showgrid\":true,\"gridcolor\":\"#ddd\",\"linecolor\":\"#ddd\",\"linewidth\":1,\"zerolinecolor\":\"black\",\"zerolinewidth\":1},\"yaxis\":{\"title\":{\"text\":\"x₂\"},\"scaleanchor\":\"x\",\"scaleratio\":1,\"showgrid\":true,\"gridcolor\":\"#ddd\",\"linecolor\":\"#ddd\",\"linewidth\":1,\"zerolinecolor\":\"black\",\"zerolinewidth\":1}}}"
            ]
