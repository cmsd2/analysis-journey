604610234207387,0.3712201331146801,0.3816092027270316,0.391617876965062,0.4012361787139156,0.41045451865297694,0.4192637081289007,0.4276549673108874,0.435619931084444,0.4431506588930082,0.45023964391950594,0.45687982052319137,0.46306456953431085,0.4687877267274952,0.474043585731105,0.4788269068514648,0.4831329222988728,0.4869573410637072,0.4902963499977595,0.4931466205055036,0.49550531047331203,0.49737006968650543,0.4987390417466799,0.49961085968104463,0.49998465357625793,0.4998600527947602,0.49923718079397816,0.4981166582255185,0.49649960209412536,0.49438762502065686,0.49178283139352735,0.48868781751693896,0.48510567028135143,0.4810399592516208,0.47649473658674235,0.4714745336056671,0.4659843561402475,0.4600296750476044,0.4536164247002243,0.4467510018236871,0.4394402469854481,0.43169144955088745,0.4235123326543957,0.4149110488412051,0.40589617330227196,0.39647669156735965,0.38666199319063244,0.3764618619347639,0.36588646530587643,0.35494634524383606,0.34365240692258137,0.33201590844800283,0.32004844942476246,0.30776195917598237,0.2951686850873928,0.282281180582161,0.2691122920853768,0.2556751466443394,0.24198313868787583,0.22804991676805345,0.21388936980151405,0.1995156132507259,0.18494297532291454,0.17018598223013692,0.15525934412101286,0.140177940167615,0.12495680381527793,0.1096111078869659,0.09415614922379602,0.07860733372315383,0.06298016073544324,0.04729020773492206,0.03155311473866137,0.015784569077976495,2.888411437308997e-7],\"type\":\"scatter3d\",\"mode\":\"markers\",\"marker\":{\"color\":\"crimson\",\"size\":3},\"opacity\":0.6,\"name\":\"geodesic γ(t)\"}],\"layout\":{\"title\":{\"text\":\"Geodesic on S² — solves the geodesic equation, traces a great circle\"},\"showlegend\":true,\"width\":700,\"height\":450,\"paper_bgcolor\":\"white\",\"scene\":{\"bgcolor\":\"white\",\"xaxis\":{\"title\":{\"text\":\"x\"},\"gridcolor\":\"#ddd\",\"linecolor\":\"#ddd\",\"linewidth\":1,\"zerolinecolor\":\"black\",\"zerolinewidth\":1},\"yaxis\":{\"title\":{\"text\":\"y\"},\"g